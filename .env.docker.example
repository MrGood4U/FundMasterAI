# Public URL: http://localhost:${APP_PORT}
APP_PORT=8080

# Local demo database credentials. Change these outside a classroom/demo setup.
FM_MYSQL_DATABASE=fundmaster_db
FM_MYSQL_USER=fundmaster_user
FM_MYSQL_PASSWORD=fundmaster_pass
FM_MYSQL_ROOT_PASSWORD=fundmaster_root

# The default stack uses mock LLM text while still loading real backend data.
LLM_MOCK_MODE=true
