LLM_API_KEY=

# Default OpenCode Go configuration used by the classroom demo.
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash

# DeepSeek V4 OpenAI-compatible API example for mainland-China team testing.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro
# LLM_THINKING_MODE=disabled
# LLM_REASONING_EFFORT=

# Multi-model OpenAI-compatible gateway example. Keep one API key/base URL and
# switch models by changing LLM_MODEL, or pass llm_model in /api/ai/fund/analyze.
# LLM_MODEL=deepseek-v4-pro
# Optional demo allowlist for GET /api/ai/llm/models and the AI Insights picker:
# LLM_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro,glm-5.1

LLM_TIMEOUT_SECONDS=60
BACKEND_FUNCTION_TIMEOUT_SECONDS=75

# Backward-compatible aliases still work if you prefer the older names.
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL_NAME=
LOG_LEVEL=INFO

# Team backend service discovery. These are used by app.py and
# fund_llm.adapters.backend_function_client.
MARKET_BACKEND_URL=http://127.0.0.1:5001
NEWS_BACKEND_URL=http://127.0.0.1:5000
PORTFOLIO_BACKEND_URL=http://127.0.0.1:5002
AGENT_HTTP_HOST=127.0.0.1
AGENT_HTTP_PORT=5003
AGENT_CORS_ORIGIN=*

# Set to true only for local smoke tests without an LLM API key.
LLM_MOCK_MODE=false
